# =============================================================================
# chotikahini — Environment variables
# Copy to .env.local for local dev. On Vercel, set these in the project env.
# Never commit real secrets.
# =============================================================================

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Site / SEO -------------------------------------------------------------
# Canonical site URL used by the OpenGraph image generators.
NEXT_PUBLIC_SITE_URL=https://chotikahini.vercel.app

# --- Optional analytics -----------------------------------------------------
# NEXT_PUBLIC_GA_ID=
# NEXT_PUBLIC_GTM_ID=
